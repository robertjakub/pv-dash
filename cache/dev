#!/bin/sh
# the dev launcher: the daemon straight from the checkout against the
# shipped sample config — the packaged-root defaults don't exist in a
# source tree (the loader never reaches into examples/ on its own). The
# audit trail rides stdout (-) so the dev terminal streams it. The
# selection rides the daemon default (every profile entry); pass
# --selection extras/examples/modbus-cache-filter.json to slim it. The
# upstream is the real inverter on the bench: $UPSTREAM overrides. Extra
# flags/env pass through: cache/dev --dry-run, cache/dev --allow-write
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
exec python3 "$DIR/bin/modbus-cache.py" \
    --config "$DIR/examples/modbus-cache.conf" \
    --audit-log - \
    --upstream "${UPSTREAM:-10.48.3.137:5502}" "$@"
