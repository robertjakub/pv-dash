#!/bin/sh
# the dev console: the cli straight from the checkout against the dev
# daemon (cache/dev — the example conf's listen, the default unix socket).
# $CACHE_CTL overrides. Extra flags pass through: cache/dev-cli --help
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
exec python3 "$DIR/bin/modbus-cache-cli.py" \
    --control-port "${CACHE_CTL:-/tmp/modbus-cache-15502.socket}" "$@"
