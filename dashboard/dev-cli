#!/bin/sh
# the dev console: the cli straight from the checkout against the dev
# daemon (dashboard/dev — the example conf's listen, the default unix socket).
# $DASHBOARD_CTL overrides. Extra flags pass through: dashboard/dev-cli --help
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
exec python3 "$DIR/bin/dashboard-cli.py" \
    --control-port "${DASHBOARD_CTL:-/tmp/dashboard-8080.socket}" "$@"
