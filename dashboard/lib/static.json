{
"control": {
  "line_cap_bytes": 1048576
},
  "defaults": {
    "port": 8080,
    "bind": "127.0.0.1",
    "upstream": "http://localhost:9090",
    "prom_prefix": "/prom",
    "proxy_timeout_s": 30,
    "log_level": "INFO",
    "log_queries": false,
    "battery": false,
    "log_access": false,
    "max_clients": 64,
    "client_timeout_s": 300.0,
    "max_conn_per_ip": 0,
    "metrics_max_clients": 16,
    "metrics_client_timeout_s": 5.0,
    "metrics_max_conn_per_ip": 0,
    "metrics_acl": "any",
    "metrics_listen": "127.0.0.1:9353",
    "audit_max_mb": 10.0,
    "audit_files": 3,
    "cli_keepalive_s": 55.0,
    "cli_timeout_s": 5.0,
    "cli_reconnect": 3,
    "cli_reconnect_wait_s": 10.0,
    "control_idle_timeout_s": 300
  },
  "log_levels": [
    "DEBUG",
    "INFO",
    "WARNING",
    "ERROR"
  ]
}
