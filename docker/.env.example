# The compose stack's .env — cp .env.example .env and edit. Compose reads
# .env from this directory (the project directory) automatically and
# interpolates the values into compose.yaml; an uncommented line here
# overrides that knob for the stack, a commented one keeps the default.
# A different file: docker compose --env-file other.env ...
#
# The names are COMPOSE-side keys, not the tools' env twins — compose maps
# each key onto the service(s) it belongs to (UPSTREAM means a different
# peer per tool — the cache's inverter vs the scraper's cache — so the keys
# are namespaced and mapped one by one).
#
# The tools resolve flag > env > config script > default: an env twin set
# from here beats the seeded /config conf file. Every pass-through keeps
# its default when the line is commented; the pass-throughs that can go
# empty pass the empty string, and every tool treats an empty env value as
# unset — commenting a line out is always safe.

# --- the poll chain -------------------------------------------------------
# The cache's upstream (the inverter's Modbus TCP HOST:PORT) and the
# scraper's (the cache's): point them at real hardware instead of the
# demo fake. The cache fronts the inverter's single client; the scraper
# polls the cache, not the device.
#CACHE_UPSTREAM=fake-inverter:5502
#SCRAPER_UPSTREAM=modbus-cache:15502

# The Modbus poll interval in seconds — both pollers pick it up — and the
# cache's TTL (how long the served values outlive a poll).
#POLL_INTERVAL=10
#CACHE_TTL=45

# --- the fake inverter ----------------------------------------------------
# The device profile the fake serves (the shipped names in profiles/:
# sun2000, deye-sg03lp1, deye-sg04lp3, deye-sg05lp3, demo-fc4).
#FAKE_PROFILE=sun2000

# --- the exporter ---------------------------------------------------------
# The bearer-token file the exporter serves with — the entrypoint generates
# the file into the config volume on the first seed (0600) and the stack's
# Prometheus reads its copy of the same file. Point it at a bind-mounted
# owner-only file to bring your own token; a chosen VALUE goes into the
# volume file (the tools take tokens by file: reference — a .env-borne
# secret would sit unencrypted and group-readable in the project directory).
#SCRAPER_TOKEN_FILE=/config/metrics.token

# The prefix of the scraper's own diagnostics metrics (scraper_*); the
# profile/compute metric names carry the profile's prefix (huawei_*).
#METRIC_PREFIX=huawei

# --- the dashboard --------------------------------------------------------
# The stack's one published host port (loopback-only, the audit's F7).
#DASHBOARD_PORT=8080
# The dashboard's upstream Prometheus (the stack's internal service).
#PROM_URL=http://prometheus:9090

# --- the whole stack ------------------------------------------------------
# Log verbosity for the cache and the scraper (LOG_LEVEL, honored at
# start); the fake re-applies its env layer on SIGHUP
# (docker compose kill -s HUP fake-inverter).
#LOG_LEVEL=INFO

# Anything beyond these knobs (the control-plane tokens, the write gates,
# the state dump): the tools' env twins work too — add the mapping to the
# service's environment: block in a docker-compose.override.yaml (the
# compose-idiomatic way, it layers over compose.yaml) instead of editing
# compose.yaml itself.
