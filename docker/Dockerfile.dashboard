# The dashboard in an alpine container — stdlib-only, no pip. The static
# single-page app plus its stdlib HTTP server with the Prometheus proxy at
# /prom. Runs as the unprivileged user `pvsuite`; the entrypoint is the
# shared one (seed the config volume, then su-exec).
#
# Build (the context = ../dashboard, the entrypoint + common = the named contexts;
# the entrypoint lives at docker/entrypoints/entrypoint.sh):
#   cd docker
#   docker build -f ../docker/Dockerfile.dashboard -t dashboard \
#       --build-context scripts=../docker --build-context common=../common ../dashboard
#   # or: docker compose up -d dashboard
#
# Run:
#   docker run --rm -p 127.0.0.1:8080:8080 dashboard   # loopback-published
#   docker run --rm -it dashboard bash                 # poke around as pvsuite
#   docker run --rm -p 127.0.0.1:8080:8080 -e PROM_URL=http://prometheus:9090 \
#       dashboard                                      # the upstream via env
#
# The config volume: the entrypoint seeds /config with the REQUIRED file
# artifacts on start (files the volume lacks are copied in, existing ones
# stay) — for the dashboard that is /config/config.js (CONFIG_JS): edit it
# there, it survives recreation. The bundled server.conf is NOT in the
# volume — the tool loads the image's /pv-suite/dashboard/server.conf (the
# default --config target: bind 0.0.0.0, port 8080) and the env overrides
# its knobs. The upstream Prometheus: the compose stack points the proxy
# at the internal prometheus service with PROM_URL (environment beats the
# conf — see ../docker/README.md).
FROM alpine:3.20

RUN apk add --no-cache python3 bash su-exec \
    && adduser -D pvsuite

WORKDIR /pv-suite
COPY --from=scripts entrypoints/entrypoint.sh /usr/local/bin/pv-entrypoint
COPY --from=common *.py common/
COPY --from=common texts.json common/
COPY --from=common modbus/*.py common/modbus/
COPY --chown=pvsuite bin/ dashboard/bin/
COPY --chown=pvsuite lib/ dashboard/lib/
COPY --chown=pvsuite static/ dashboard/static/
COPY --chown=pvsuite examples/server.conf dashboard/
COPY --chown=pvsuite examples/config.js examples/page.token config-defaults/
RUN chmod +x dashboard/bin/*.py /usr/local/bin/pv-entrypoint \
    && ln -s /pv-suite/dashboard/bin/dashboard.py /usr/local/bin/dashboard \
    && ln -s /pv-suite/dashboard/bin/dashboard-ctl.py /usr/local/bin/dashboard-ctl \
    && ln -s /pv-suite/dashboard/bin/dashboard-cli.py /usr/local/bin/dashboard-cli

# The entrypoint runs as root only to seed /config, then drops to pvsuite.
# CONFIG_JS points the served config.js at the volume copy; the bundled
# server.conf loads via the built-in default --config target
# (/pv-suite/dashboard/server.conf — bind 0.0.0.0, port 8080) — env and
# flags override it.
ENV CONFIG_JS=/config/config.js
VOLUME /config
ENTRYPOINT ["/usr/local/bin/pv-entrypoint"]

EXPOSE 8080
# the container binds every interface (a published port needs it) — beyond
# loopback the page's bearer token is mandatory (F21): the compose rides
# the generated /config/page.token, a plain run passes AUTH_TOKEN
CMD ["dashboard", "--listen", "0.0.0.0:8080"]

# Liveness: the ctl answers over the server's unix control socket (the
# default socket follows the bundled conf's port; the check runs as root —
# a trusted peer over SO_PEERCRED, so no token is needed).
HEALTHCHECK --interval=5m --timeout=5s --start-period=15s --retries=3 \
    CMD ["dashboard-ctl", "ping"]
