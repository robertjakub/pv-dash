# Fake Inverter Simulator in an alpine container — stdlib-only, no pip.
# Runs as the unprivileged user `pvsuite`; the profiles come from the shared
# profiles/ directory via a named build context.
#
# Build (the context = ../inverter, the profiles = ../profiles, the entrypoint
# = ../docker, the shared code = ../common):
#   cd docker
#   docker build -f ../docker/Dockerfile.fake-inverter -t fake-inverter \
#       --build-context profiles=../profiles \
#       --build-context scripts=../docker --build-context common=../common ../inverter
#   # or: docker compose up -d
#
# Run:
#   docker run --rm -p 127.0.0.1:5502:5502 fake-inverter   # loopback-published; the compose stack publishes nothing
#   docker run --rm -it fake-inverter bash                 # poke around as pvsuite
#   docker run --rm -p 127.0.0.1:5502:5502 fake-inverter \
#       fake-inverter --profile deye-sg04lp3 --no-battery    # any flags via the CMD override
#
# The config volume: the entrypoint seeds /config with the required file
# artifacts (for the fake: none — no seeding happens). The volume is there
# for symmetry with the other images and for future use.
FROM alpine:3.20

RUN apk add --no-cache python3 bash su-exec \
    && adduser -D pvsuite

WORKDIR /pv-suite
COPY --chown=pvsuite --from=profiles profiles/profiles/ profiles/
COPY --from=scripts entrypoint.sh /usr/local/bin/pv-entrypoint
COPY --from=common *.py common/
COPY --from=common modbus/*.py common/modbus/
COPY --chown=pvsuite bin/ inverter/bin/
COPY --chown=pvsuite lib/ inverter/lib/
RUN chmod +x inverter/bin/*.py /usr/local/bin/pv-entrypoint \
    && ln -s /pv-suite/inverter/bin/modbus-fake-inverter.py /usr/local/bin/fake-inverter \
    && ln -s /pv-suite/inverter/bin/modbus-fake-ctl.py /usr/local/bin/fake-ctl \
    && ln -s /pv-suite/inverter/bin/modbus-fake-cli.py /usr/local/bin/fake-cli

# The entrypoint runs as root only to seed /config, then drops to pvsuite.
VOLUME /config
ENTRYPOINT ["/usr/local/bin/pv-entrypoint"]

EXPOSE 5502
CMD ["fake-inverter", "--host", "0.0.0.0", "--port", "5502", "--audit-log", "-"]

# Liveness: the ctl answers over the fake's unix control socket (the
# default socket follows the CMD's port; the check runs as root — a
# trusted peer over SO_PEERCRED, so no token is needed).
HEALTHCHECK --interval=5m --timeout=5s --start-period=15s --retries=3 \
    CMD ["fake-ctl", "show", "version"]
