# modbus-cache in an alpine container — stdlib-only, no pip.
# Runs as the unprivileged user `pvsuite`; the profiles come from the shared
# profiles/ directory via a named build context.
#
# Build (the context = ../cache, the profiles = ../profiles, the entrypoint
# = ../docker/entrypoints, the shared code = ../common):
#   cd docker
#   docker build -f ../docker/Dockerfile.modbus-cache -t modbus-cache \
#       --build-context profiles=../profiles \
#       --build-context scripts=../docker --build-context common=../common ../cache
#   # or: docker compose up -d modbus-cache
#
# Run:
#   docker run --rm -p 127.0.0.1:15502:15502 modbus-cache    # loopback-published; the
#                                                            # compose stack publishes nothing
#   docker run --rm -it modbus-cache bash                    # poke around as pvsuite
#   docker run --rm -p 127.0.0.1:15502:15502 modbus-cache \
#       modbus-cache --upstream 192.168.1.100:5502          # any flags via the CMD override
#
# The config volume: the entrypoint seeds /config with the REQUIRED file
# artifacts on start (files the volume lacks are copied in, existing ones
# stay) — for the cache that is /config/selection.json (SELECTION): edit it
# there, it survives recreation. The bundled conf is NOT in the volume —
# the tool loads the image's /pv-suite/cache/modbus_cache.conf (the default
# --config target) and the per-tool env file env/cache.env overrides its
# knobs (see ../docker/README.md); a flag beats the env: `docker run ...
# modbus-cache --upstream 10.0.0.9:5502` on top.
FROM alpine:3.20

RUN apk add --no-cache python3 bash su-exec \
    && adduser -D pvsuite

WORKDIR /pv-suite
COPY --chown=pvsuite --from=profiles profiles/profiles/ profiles/
COPY --from=scripts entrypoints/entrypoint.sh /usr/local/bin/pv-entrypoint
COPY --from=common *.py common/
COPY --from=common modbus/*.py common/modbus/
COPY --chown=pvsuite bin/ cache/bin/
COPY --chown=pvsuite lib/ cache/lib/
COPY --chown=pvsuite examples/modbus_cache.conf examples/selection.json examples/acl-write-registers.json cache/
COPY --chown=pvsuite examples/selection.json config-defaults/
# the suite key's placeholder: the entrypoint materializes any *.token in
# config-defaults as a random value on the first seed (the bundled content
# is never copied) — the compose stacks point the cache's two auth sides
# at /config/modbus-auth.token (its clients' handshake and, when the
# device speaks suite, the upstream handshake)
RUN echo placeholder > config-defaults/modbus-auth.token
RUN chmod +x cache/bin/*.py /usr/local/bin/pv-entrypoint \
    && ln -s /pv-suite/cache/bin/modbus-cache.py /usr/local/bin/modbus-cache \
    && ln -s /pv-suite/cache/bin/modbus-cache-ctl.py /usr/local/bin/modbus-cache-ctl \
    && ln -s /pv-suite/cache/bin/modbus-cache-cli.py /usr/local/bin/modbus-cache-cli

# The entrypoint runs as root only to seed /config, then drops to pvsuite.
# UPSTREAM is the image's default upstream peer (fake-inverter:5502 — the
# compose stack's fake service; the flag would pin it past every env).
# The bundled conf loads via the built-in default --config target
# (/pv-suite/cache/modbus_cache.conf) — env and flags override it.
ENV SELECTION=/config/selection.json \
    UPSTREAM=fake-inverter:5502
VOLUME /config
ENTRYPOINT ["/usr/local/bin/pv-entrypoint"]

EXPOSE 15502
CMD ["modbus-cache", "--listen", "0.0.0.0:15502", "--audit-log", "-"]

# Liveness: the ctl answers over the daemon's unix control socket (the
# default socket follows the CMD's listen port; the check runs as root —
# a trusted peer over SO_PEERCRED, so no token is needed). Disabling the
# control plane (CTL=0) fails the check.
HEALTHCHECK --interval=5m --timeout=5s --start-period=15s --retries=3 \
    CMD ["modbus-cache-ctl", "show", "version"]
