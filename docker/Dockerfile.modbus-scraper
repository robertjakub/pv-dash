# modbus-scraper in an alpine container — stdlib-only, no pip.
# Runs as the unprivileged user `pvsuite`; the profiles come from the shared
# build context (shared/profiles/).
#
# Build (the context = ../apps/scraper, the entrypoint
# = ../docker/entrypoints, the shared code = ../common):
#   cd docker
#   docker build -f ../docker/Dockerfile.modbus-scraper -t modbus-scraper \
#       --build-context shared=../shared \
#       --build-context scripts=../docker --build-context common=../common ../apps/scraper
#   # or: docker compose up -d modbus-scraper
#
# Run:
#   docker run --rm -p 127.0.0.1:9350:9350 modbus-scraper    # loopback-published; the
#                                                            # compose stack publishes nothing
#   docker run --rm -it modbus-scraper bash                  # poke around as pvsuite
#   docker run --rm -p 127.0.0.1:9350:9350 modbus-scraper \
#       modbus-scraper --upstream 192.168.1.100:502        # any flags via the CMD override
#
# The config volume: the entrypoint seeds /config with the REQUIRED file
# artifacts on start (files the volume lacks are copied in, existing ones
# stay) — for the scraper those are /config/metrics.json (METRICS_SPEC) and
# the generated /config/metrics.token: edit the spec there, it survives
# recreation. The bundled conf is NOT in the volume — the tool loads the
# image's /pv-suite/scraper/modbus-scraper.conf (the default --config target) and
# the per-tool env file (env/scraper.env — the demo and plain-docker
# spelling; the prod copy carries -production) overrides its knobs (see
# ../docker/README.md; a flag beats the env: `docker run ... modbus-scraper
# --upstream 10.0.0.2:15502` on top). The compose stacks add
# AUTH_TOKEN=file:/config/metrics.token (a random token the entrypoint
# generates on the first seed, 0600, pvsuite, shared with the stack's
# Prometheus) and AUTH/MODBUS_AUTH_KEY=file:/config/modbus-auth.token: the
# stack's Modbus hops ship authenticated (see README.md).
FROM alpine:3.20

RUN apk add --no-cache python3 bash su-exec \
    && adduser -D pvsuite

WORKDIR /pv-suite
COPY --chown=pvsuite --from=shared profiles/ profiles/
COPY --from=scripts entrypoints/entrypoint.sh /usr/local/bin/pv-entrypoint
COPY --from=common *.py common/
COPY --from=common modbus/*.py common/modbus/
COPY --from=shared suite/texts.json shared/suite/
COPY --from=shared suite/protocol.json shared/suite/
COPY --from=shared suite/wire.json shared/suite/
COPY --chown=pvsuite bin/ scraper/bin/
COPY --chown=pvsuite lib/ scraper/lib/
COPY --chown=pvsuite examples/modbus-scraper.conf examples/metrics.json scraper/
COPY --chown=pvsuite examples/metrics.json config-defaults/
# the token placeholders: the entrypoint materializes any *.token in
# config-defaults as a random value on the first seed (the placeholder
# content is never copied) — metrics.token is the compose stacks' shared
# exporter bearer (the scraper + Prometheus), modbus-auth.token the suite
# key the stacks point the scraper's client-side auth at
# (/config/modbus-auth.token, the handshake it proves to the cache)
RUN echo placeholder > config-defaults/modbus-auth.token \
    && echo placeholder > config-defaults/metrics.token
RUN chmod +x scraper/bin/*.py /usr/local/bin/pv-entrypoint \
    && ln -s /pv-suite/scraper/bin/modbus-scraper.py /usr/local/bin/modbus-scraper \
    && ln -s /pv-suite/scraper/bin/modbus-scraper-cli.py /usr/local/bin/modbus-scraper-cli

# The entrypoint runs as root only to seed /config, then drops to pvsuite.
# UPSTREAM is the image's default upstream peer (modbus-cache:15502 — the
# compose stack's cache service; the flag would pin it past every env).
# The bundled conf loads via the built-in default --config target
# (/pv-suite/scraper/modbus-scraper.conf) — env and flags override it.
ENV METRICS_SPEC=/config/metrics.json \
    UPSTREAM=modbus-cache:15502
VOLUME /config
ENTRYPOINT ["/usr/local/bin/pv-entrypoint"]

EXPOSE 9350
CMD ["modbus-scraper", "--listen", "0.0.0.0:9350"]

# Liveness: the ctl answers over the daemon's unix control socket (the
# default socket follows the CMD's listen port; the check runs as root —
# a trusted peer over SO_PEERCRED, so no token is needed).
HEALTHCHECK --interval=5m --timeout=5s --start-period=15s --retries=3 \
    CMD ["modbus-scraper-cli", "ping"]
