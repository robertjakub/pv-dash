# The demo stack's Prometheus collector — alpine + the prometheus
# package, stdlib-style (no pip, no python); production brings its own
# collector (the prod stack ships none — this image is the reference
# wiring for pulling the exporter's /metrics with the bearer token).
# The pattern of the Modbus images: an unprivileged user, an entrypoint
# that runs as root only for the token handoff, then su-exec drops
# before the exec.
#
# Build (the context = the docker/ directory itself; the alerts rules
# pack rides the exporter = the scraper tree, as a named build context;
# both compose stacks — demo/ and prod/ — build this image):
#   cd docker
#   docker build -t prometheus -f Dockerfile.prometheus \
#       --build-context alerts=../scraper .
#   # or: cd docker/demo (or docker/prod) && docker compose up -d prometheus
#
# The entrypoint waits for /config/metrics.token (the modbus-scraper's
# entrypoint seeds it into the shared config volume — a random value,
# 0600, owner pvsuite), copies it for the prometheus user, and execs.
# The UI serves on the compose network only — the stacks publish no 9090
# port; the dashboard's proxy is the way in.
FROM alpine:3.20

RUN apk add --no-cache prometheus su-exec

# the alpine package ships its own system user; this is a no-op then
RUN adduser -D prometheus 2>/dev/null || true

COPY prometheus.yml /etc/prometheus/prometheus.yml
# the exporter's alert rules pack (scraper/alerts.yml — the F16 pack,
# wired by prometheus.yml's rule_files)
COPY --from=alerts alerts.yml /etc/prometheus/alerts.yml
COPY entrypoints/entrypoint-prometheus.sh /usr/local/bin/pv-prometheus-entrypoint
RUN chmod +x /usr/local/bin/pv-prometheus-entrypoint \
    && mkdir -p /prometheus \
    && chown -R prometheus:prometheus /etc/prometheus /prometheus

VOLUME /prometheus
EXPOSE 9090
ENTRYPOINT ["/usr/local/bin/pv-prometheus-entrypoint"]

# Liveness: busybox wget against the /-/ready probe (the UI serves on the
# compose network only — the loopback target works inside the container).
HEALTHCHECK --interval=5m --timeout=5s --start-period=30s --retries=3 \
    CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:9090/-/ready"]
