# modbus-scraper in an alpine container — stdlib-only, no pip.
# Runs as the unprivileged user `pvsuite`; the profiles come from the shared
# profiles/ directory via a named build context.
#
# Build (the context = ../scrape, the profiles = ../profiles, the entrypoint
# = ../docker, the shared code = ../common):
#   cd docker
#   docker build -t modbus-scraper --build-context profiles=../profiles \
#       --build-context scripts=../docker --build-context common=../common ../scrape
#   # or: docker compose up -d modbus-scraper
#
# Run:
#   docker run --rm -p 127.0.0.1:9350:9350 modbus-scraper    # loopback-published; the
#                                                            # compose stack publishes nothing
#   docker run --rm -it modbus-scraper bash                  # poke around as pvsuite
#   docker run --rm -p 127.0.0.1:9350:9350 modbus-scraper \
#       modbus-scraper --upstream 192.168.1.100:502        # any flags via the CMD override
#
# The config volume: the entrypoint seeds /config with the bundled defaults
# on start (files the volume lacks are copied in, existing ones stay) — edit
# /config/scraper.conf and /config/metrics.json there, they survive
# recreation. The ENV vars below point the tool at the volume copies and
# carry the demo stack's default upstream (the per-tool env file
# env/scraper.env overrides it — see ../docker/README.md; a flag beats the
# env: `docker run ... modbus-scraper --upstream 10.0.0.2:15502` on top).
# The compose stack adds AUTH_TOKEN_FILE=/config/metrics.token: a random
# token the entrypoint generates on the first seed (0600, pvsuite — bundled
# metrics.token is a placeholder that is never copied), shared with the
# demo Prometheus (see README.md).
FROM alpine:3.20

RUN apk add --no-cache python3 bash su-exec \
    && adduser -D pvsuite

WORKDIR /pv-suite
COPY --chown=pvsuite --from=profiles profiles/profiles/ profiles/
COPY --from=scripts entrypoint.sh /usr/local/bin/pv-entrypoint
COPY --from=common *.py common/
COPY --chown=pvsuite bin/ scraper/bin/
COPY --chown=pvsuite lib/ scraper/lib/
COPY --chown=pvsuite scraper.conf metrics.json scraper/
COPY --chown=pvsuite scraper.conf metrics.json metrics.token config-defaults/
RUN chmod +x scraper/bin/*.py /usr/local/bin/pv-entrypoint \
    && ln -s /pv-suite/scraper/bin/modbus-scraper.py /usr/local/bin/modbus-scraper

# The entrypoint runs as root only to seed /config, then drops to pvsuite.
# UPSTREAM is the image's default upstream peer (modbus-cache:15502 — the
# compose stack's cache service; the flag would pin it past every env).
ENV CONFIG=/config/scraper.conf \
    METRICS_SPEC=/config/metrics.json \
    UPSTREAM=modbus-cache:15502
VOLUME /config
ENTRYPOINT ["/usr/local/bin/pv-entrypoint"]

EXPOSE 9350
CMD ["modbus-scraper", "--listen", "0.0.0.0:9350"]
