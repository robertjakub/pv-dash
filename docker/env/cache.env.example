# The modbus-cache's env file — GENERATED by scripts/gen_examples.py from
# cache/lib/options.json (the one-knob-one-source rows): every env twin the
# registry declares is below — 51 of them. Edit the registry and re-run the
# generator, never this file. cp env/cache.env.example env/cache.env (the
# demo stack) or env/cache-production.env (the prod stack) and edit. A
# knob's value resolves flag > env > the bundled conf > built-in default —
# an env here overrides the image's conf knob by knob. Every line starts
# commented: the sample value is what the image itself runs (the CMD flag or
# an ENV where one pins it, the built-in default otherwise); a secret's line
# stays empty — pass it as file:<path>, an owner-only 0600 file (the F12
# discipline).

# Both compose stacks read the file (env_file: — the demo copy optional, the
# prod copy REQUIRED: UPSTREAM is the operator's decision there); where a
# stack's environment block pins a knob (environment beats env_file) the
# notes below mark it.

# --- modbus ---

# the inverter Modbus TCP endpoint HOST:PORT (`:5502` = 127.0.0.1:5502)
# the image's ENV carries this default (the compose stack's peer service) —
# the env file wins over an ENV
#UPSTREAM=modbus-fake-inverter:5502

# the Modbus unit id the session speaks
#MODBUS_UNIT=1

# upstream Modbus connect/read timeout in seconds
#MODBUS_TIMEOUT=3

# the auth scheme the cache's own Modbus clients must speak: suite (the
# crypt handshake) or none
# both compose stacks pin this to the stack's suite key (the environment
# block — environment beats env_file)
#MODBUS_AUTH=none

# the suite handshake's shared key for the cache's clients, min 16
# characters (`file:<path>` reads an owner-only file)
# both compose stacks pin this to the stack's suite key (the environment
# block — environment beats env_file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#MODBUS_AUTH_KEY=

# the auth scheme the cache speaks to the upstream inverter: suite (the
# crypt handshake), waveshare (the gateway connection password) or none
# the demo stack pins this to the stack's suite key; in prod the upstream
# credential is the device's — this file is its edit surface
#MODBUS_UPSTREAM_AUTH=none

# the key the cache presents upstream: the suite handshake's shared key (min
# 16 characters) or the Waveshare gateway password (`file:<path>` reads an
# owner-only file)
# the demo stack pins this to the stack's suite key; in prod the upstream
# credential is the device's — this file is its edit surface
# a secret — pass it as file:<path>, an owner-only 0600 file
#MODBUS_UPSTREAM_AUTH_KEY=

# seconds between cache polls of the device
#MODBUS_INTERVAL=10

# seconds between consecutive device reads within a poll cycle
#MODBUS_READ_DELAY=0.05

# max register gap when merging ranges into block reads; the plan rebuilds
#MODBUS_MERGE_GAP=8

# device profile JSON: the register ranges to cache (a bare name resolves in
# profiles/profiles/)
#MODBUS_PROFILE=sun2000

# selection JSON: which profile names to fetch ("all" = every entry, "none"
# = cache nothing)
# the image's ENV points it at the volume copy — the env file wins over an
# ENV
#SELECTION=/config/selection.json

# --- general ---

# per-register cache TTL: older entries are refetched
#TTL=30

# --- write ---

# forward write requests (FC05/06/15/16/22/23) to the device
#ALLOW_WRITE=off

# the address ranges a write may touch (FC06/16/22/23 registers, FC05/15
# coils): START:COUNT,... or the device profile's acl
#WRITE_REGISTERS=none

# --- acl ---

# clients allowed to connect: "any", "none", comma-separated IPs/prefixes,
# or file:<path> (the ip-prefix acl file)
#CONNECT_ACL=any

# clients allowed to write (requires allow-write): "any", "none",
# comma-separated IPs/prefixes, or file:<path> (the ip-prefix acl file)
#WRITE_ACL=none

# --- system ---

# listen address HOST:PORT
# the image's CMD pins this flag — the env file cannot beat it in docker
# (replace the CMD to move the bind); the twin serves the non-docker
# surfaces
#LISTEN=0.0.0.0:15502

# log timestamps in the system time zone instead of UTC
#LOCAL_TIME=off

# log verbosity
#LOG_LEVEL=INFO

# log client connects/disconnects at INFO instead of DEBUG
#LOG_ACCESS=off

# --- limits ---

# simultaneous client limit
#MAX_CLIENTS=64

# disconnect clients silent for this long
#CLIENT_TIMEOUT=300

# simultaneous connections from one peer IP
#MAX_CONN_PER_IP=0

# --- control ---

# control server target: unix socket path or TCP port on 127.0.0.1
#CTL=

# require a token on control connections: the client authenticates with
# {"cmd": "auth", "token":...}; over the unix socket a trusted peer (root,
# the daemon's own user or --control-trust-uids — SO_PEERCRED) skips the
# token (`file:<path>` = the token from an owner-only file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#CONTROL_TOKEN=

# extra peer uids the unix control socket trusts without the token
# (SO_PEERCRED — a local systemd unit speaks without the secret); root and
# the daemon's own user are always trusted
#CONTROL_TRUST_UIDS=

# leave the unix control socket group-accessible (chmod 0660 instead of the
# plain 0600)
#CONTROL_SOCKET_GROUP=off

# --- control/ops ---

# a second, read-only control token: sessions authenticating with it may run
# its policy's verbs only (the default policy: show,flush) (no set/clear, no
# request poll now, no request dump/restore, no restart, no shutdown) — the
# ops shift against the admin key, both audited (`file:<path>` = the token
# from an owner-only file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#CONTROL_OPS_TOKEN=

# the read-only ops role's RBAC policy: the verbs its sessions may run,
# comma-separated
#CONTROL_OPS_VERBS=show,flush

# --- metrics ---

# the cache's own Prometheus /metrics endpoint (needs a token beyond
# loopback; the address is --metrics-listen)
#METRICS_SERVER=off

# the metrics bind address HOST:PORT — the set records the value, the
# restart (request reload) applies it
#METRICS_LISTEN=127.0.0.1:9351

# the metrics bearer token (Authorization: Bearer) — startup-only (pass it
# by flag/env/config); the value never renders back (`file:<path>` = the
# token from an owner-only file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#METRICS_TOKEN=

# clients allowed to connect to /metrics: "any", "none", comma-separated
# IPs/prefixes, or file:<path> (the ip-prefix acl file)
#METRICS_ACL=any

# --- metrics/limits ---

# maximum concurrent /metrics clients; extras get an immediate 503, 0 =
# unlimited
#METRICS_MAX_CLIENTS=64

# seconds an idle /metrics client is kept before the socket times out, 0 =
# the built-in 5 s cap
#METRICS_CLIENT_TIMEOUT=5

# maximum concurrent /metrics connections from one peer IP, 0 = no per-IP
# limit
#METRICS_MAX_CONN_PER_IP=0

# --- audit ---

# the audit trail's file: a path, - for stdout, none = no local file (the
# forward carries the trail), empty = the XDG state home
# the image's CMD pins this flag — the env file cannot beat it in docker
# (replace the CMD to move the bind); the twin serves the non-docker
# surfaces
#AUDIT_LOG=-

# also forward every audit line: the local syslog mirror or a remote
# collector (the off-box copy)
#AUDIT_FORWARD=none

# the remote forward's envelope: RFC5424 (the default) or CEF — the local
# syslog forms keep the verbatim send
#AUDIT_FORWARD_FORMAT=rfc5424

# the audit lines' instance word: the writer daemon's identity — the control
# port when unset, the override when spelled
#AUDIT_INSTANCE=

# disable the audit trail entirely
#NO_AUDIT_LOG=off

# audit one REQUESTS tally per client per this many seconds
#AUDIT_REQUESTS=300

# --- audit/rotate ---

# rotate the audit trail at this size in MB, keeping N backups; 0 = no size
# rotation
#AUDIT_MAX_MB=10

# also rotate the audit trail at UTC midnight
#AUDIT_DAILY=off

# rotated audit backups to keep
#AUDIT_FILES=3

# --- dump ---

# the state dump file: written behind, on request dump and every
# dump-interval
#DUMP_PATH=

# the key that seals the state dumps (the words and the settings, the
# reload's state file too) (`file:<path>` reads an owner-only file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#DUMP_KEY=

# the dump carries the cached register words too
#DUMP_WITH_CACHE=off

# seconds between the automatic state dumps (the cached words + the setting
# overrides)
#DUMP_INTERVAL=0

# the dump loads on start (off: on demand with request restore)
#RESTORE_ON_START=off
