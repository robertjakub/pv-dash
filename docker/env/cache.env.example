# modbus-cache's env file — cp env/cache.env.example env/cache.env and
# edit. Consumed two ways: `docker run --env-file env/cache.env
# modbus-cache` and the compose stack's env_file: (required: false — no
# file = the image defaults). The names are the tool's bare env twins
# (flag > env > the bundled conf > built-in defaults — an env here
# overrides the image's /pv-suite/cache/modbus_cache.conf knob by knob);
# every line starts commented, the defaults live in the image.

# The upstream inverter (Modbus TCP HOST:PORT) — the demo default is the
# stack's fake-inverter service (the image's UPSTREAM env); point it at
# real hardware here.
#UPSTREAM=fake-inverter:5502

# The auth scheme toward the upstream device: suite (the crypt handshake)
# or waveshare (the gateway connection password) — the device's
# credential, the operator's decision. The compose stacks pin the cache's
# SERVER side (AUTH/AUTH_KEY, the generated /config/modbus-auth.token)
# and cannot be overridden from here (environment beats env_file); the
# upstream side stays yours. The key is a secret: an inline value or
# file:<path> (an owner-only 0600 file, the F12 discipline).
#AUTH_UPSTREAM=suite
#AUTH_UPSTREAM_KEY=file:/config/device.key

# The Modbus poll interval in seconds, and how long the served values
# outlive a poll (the TTL).
#INTERVAL=10
#TTL=45


# The audit trail (a path or - for stdout; the rotation knobs and the
# UTC-midnight trigger ride the family bounds).
#AUDIT_LOG=-
#AUDIT_MAX_MB=10
#AUDIT_DAILY=off
#AUDIT_FILES=3
#AUDIT_FORWARD=none
#NO_AUDIT_LOG=off

# DEBUG|INFO|WARNING|ERROR
#LOG_LEVEL=INFO
