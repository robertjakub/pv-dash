# modbus-cache's env file — cp env/cache.env.example env/cache.env and
# edit. Consumed two ways: `docker run --env-file env/cache.env
# modbus-cache` and the compose stack's env_file: (required: false — no
# file = the image defaults). The names are the tool's bare env twins
# (flag > env > the bundled conf > built-in defaults — an env here
# overrides the image's /pv-suite/cache/modbus_cache.conf knob by knob);
# every line starts commented, the defaults live in the image.

# The upstream inverter (Modbus TCP HOST:PORT) — the demo default is the
# stack's fake-inverter service (the image's UPSTREAM env); point it at
# real hardware here.
#UPSTREAM=fake-inverter:5502

# The Modbus poll interval in seconds, and how long the served values
# outlive a poll (the TTL).
#INTERVAL=10
#TTL=45

# DEBUG|INFO|WARNING|ERROR
#LOG_LEVEL=INFO
