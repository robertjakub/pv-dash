# The dashboard's env file — GENERATED by scripts/gen_env.py from
# dashboard/lib/options.json (the one-knob-one-source rows): every env twin
# the registry declares is below — 38 of them. Edit the registry and re-run
# the generator, never this file. cp env/dashboard.env.example
# env/dashboard.env and edit. A knob's value resolves flag > env > the
# bundled conf > built-in default — an env here overrides the image's conf
# knob by knob. Every line starts commented: the sample value is what the
# image itself runs (the CMD flag or an ENV where one pins it, the built-in
# default otherwise); a secret's line stays empty — pass it as file:<path>,
# an owner-only 0600 file (the F12 discipline).

# No compose stack reads this file — the plain-docker spelling: the stacks'
# PROM_URL and page token are compose-level environment blocks (edit the
# compose or a docker-compose.override.yaml to move them).

# --- system ---

# listen address HOST:PORT
# the image's CMD pins this flag — the env file cannot beat it in docker
# (replace the CMD to move the bind); the twin serves the non-docker
# surfaces
#LISTEN=0.0.0.0:8080

# DEBUG-log the full output of every control command (plainly: the command
# and its status log)
#CONTROL_LOG_REPLIES=off

# log verbosity
#LOG_LEVEL=INFO

# log every HTTP request at INFO
#LOG_ACCESS=off

# log timestamps in the system time zone instead of UTC
#LOCAL_TIME=off

# --- general ---

# upstream Prometheus URL
#PROM_URL=http://prometheus:9090

# path under which Prometheus is proxied
#PROM_PREFIX=/prom

# directory to serve (startup-only: flag/env/config and restart)
# a secret — pass it as file:<path>, an owner-only 0600 file
#STATIC_DIR=

# config.js to serve at /config.js (startup-only: flag/env/config and
# restart)
# the image's ENV points it at the volume copy — the env file wins over an
# ENV
# a secret — pass it as file:<path>, an owner-only 0600 file
#CONFIG_JS=/config/config.js

# simultaneous HTTP clients (static pages + the proxy); extras get an
# immediate 503
#MAX_CLIENTS=64

# kick idle keep-alive HTTP clients after this long
#CLIENT_TIMEOUT=300

# simultaneous HTTP connections from one peer IP
#MAX_CONN_PER_IP=0

# the metrics bind address HOST:PORT
#METRICS_LISTEN=127.0.0.1:9353

# maximum concurrent /metrics clients; extras get an immediate 503, 0 =
# unlimited
#METRICS_MAX_CLIENTS=16

# seconds an idle /metrics client is kept before the socket times out, 0 =
# the built-in 5 s cap
#METRICS_CLIENT_TIMEOUT=5

# maximum concurrent /metrics connections from one peer IP, 0 = no per-IP
# limit
#METRICS_MAX_CONN_PER_IP=0

# log the proxied Prometheus queries at INFO
#LOG_QUERIES=off

# seconds between the automatic state dumps (the live setting overrides)
#DUMP_INTERVAL=0

# --- auth ---

# require Authorization: Bearer <token> on the page, config.js and the proxy
# — mandatory beyond loopback; the `?auth=<token>` query bootstraps the
# session cookie; startup-only (pass it by flag/env/config); the value never
# renders back (`file:<path>` = the token from an owner-only file)
# the compose stacks ride the generated /config/page.token — this line is
# the plain-docker spelling
# a secret — pass it as file:<path>, an owner-only 0600 file
#AUTH_TOKEN=

# --- control ---

# JSON-lines control server target: unix socket path
#CTL=

# require a token on control connections: the client authenticates with
# {"cmd": "auth", "token":...}; over the unix socket a trusted peer (root,
# the daemon's own user or --control-trust-uids — SO_PEERCRED) skips the
# token (`file:<path>` = the token from an owner-only file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#CONTROL_TOKEN=

# extra peer uids the unix control socket trusts without the token
# (SO_PEERCRED — a local systemd unit speaks without the secret); root and
# the daemon's own user are always trusted
#CONTROL_TRUST_UIDS=

# leave the unix control socket group-accessible (chmod 0660 instead of the
# plain 0600)
#CONTROL_SOCKET_GROUP=off

# --- control/ops ---

# a second, read-only control token: sessions authenticating with it may run
# its policy's verbs only (the default policy: show) (no set/clear, no
# request reload, no shutdown) — the ops shift against the admin key, both
# audited (`file:<path>` = the token from an owner-only file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#CONTROL_OPS_TOKEN=

# the read-only ops role's RBAC policy: the verbs its sessions may run,
# comma-separated
#CONTROL_OPS_VERBS=show

# --- metrics ---

# the dashboard's own Prometheus /metrics endpoint (needs a token beyond
# loopback; the address is --metrics-listen)
#METRICS_SERVER=off

# require Authorization: Bearer <token> on the /metrics endpoint — mandatory
# beyond loopback; startup-only (pass it by flag/env/config); the value
# never renders back (`file:<path>` = the token from an owner-only file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#METRICS_TOKEN=

# clients allowed to connect to /metrics: "any", "none", comma-separated
# IPs/prefixes, or file:<path> (the ip-prefix acl file)
#METRICS_ACL=any

# --- audit ---

# DSH audit trail: a file path or - for stdout (the docker/journald way);
# `none` = no local file (the forward carries the trail); the XDG state home
# when unset
#AUDIT_LOG=

# also forward every audit line: the local syslog mirror or a remote
# collector (the off-box copy)
#AUDIT_FORWARD=none

# the remote forward's envelope: RFC5424 (the default) or CEF — the local
# syslog forms keep the verbatim send
#AUDIT_FORWARD_FORMAT=rfc5424

# disable the DSH audit trail
#NO_AUDIT_LOG=off

# --- audit/rotate ---

# rotate the audit log at this size in MB, keeping N backups; 0 = no size
# rotation
#AUDIT_MAX_MB=10

# also rotate the audit log at UTC midnight
#AUDIT_DAILY=off

# rotated audit backups to keep
#AUDIT_FILES=3

# --- dump ---

# the state dump file: the live overrides, written on request dump, the
# graceful shutdown and every dump-interval
#DUMP_PATH=

# the key that seals the state dumps (the reload's state file too)
# (`file:<path>` reads an owner-only file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#DUMP_KEY=

# the dump loads on start (off: on demand with request restore)
#RESTORE_ON_START=off
