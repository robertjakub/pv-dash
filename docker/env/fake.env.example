# The fake inverter's env file — cp env/fake.env.example env/fake.env and
# edit. Consumed two ways: `docker run --env-file env/fake.env
# fake-inverter` and the compose stack's env_file: (required: false — no
# file = the code defaults). The names are the tool's bare env twins.

# The device profile the fake serves (the shipped names in profiles/:
# sun2000, deye-sg03lp1, deye-sg04lp3, deye-sg05lp3, demo-fc4).
#PROFILE=sun2000

# The startup knobs (the flag > env > static ladder — an env value wins
# over the built-in default, a CMD flag wins over the env):
#LISTEN=0.0.0.0:5502
#MAX_CLIENTS=64
#CLIENT_TIMEOUT=300
#MAX_CONN_PER_IP=0
# the audit trail (AUDIT_LOG: a path or - for stdout — the default sink
# in docker is stdout via the image's CMD flag)
#AUDIT_LOG=-
#AUDIT_MAX_MB=10
#AUDIT_DAILY=off
#AUDIT_FILES=3
#NO_AUDIT_LOG=off

# The simulation envs below are the SIGHUP layer, NOT startup: they reach
# a container when it is created with them in the environment (compose
# recreates on an env-file change) or on
# `docker compose kill -s HUP fake-inverter`.
#
# the hostile-reply probability, 0..1
#CHAOS=0.05
# the PV array size in kWp (peak = 75 % of it)
#MAX_KWP=20
# exception 02 on undefined registers, on|off
#STRICT=on
# freeze the simulated clock, HH:MM
#TIME=13:37
# the simulated clock speed: N times real time
#TIME_SCALE=1
