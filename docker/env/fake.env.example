# The fake inverter's env file — cp env/fake.env.example env/fake.env and
# edit. Consumed two ways: `docker run --env-file env/fake.env
# fake-inverter` and the compose stack's env_file: (required: false — no
# file = the image defaults). The names are the tool's bare env twins.
# The startup knobs also ride the image's own config script
# (/pv-suite/inverter/inverter.conf): flag > env > config > default —
# the env file is the override layer between the flags and the conf.

# The device profile the fake serves (the shipped names in profiles/:
# sun2000, deye-sg03lp1, deye-sg04lp3, deye-sg05lp3, demo-fc4) — a
# both-layers twin: the SIGHUP re-read applies it too.
#PROFILE=sun2000

# the log verbosity (a both-layers twin as well)
#LOG_LEVEL=INFO

# The startup knobs (the flag > env > config > static ladder — an env
# value wins over the config file and the built-in default, a CMD flag
# wins over the env):
#LISTEN=0.0.0.0:5502
#MAX_CLIENTS=64
#CLIENT_TIMEOUT=300
#MAX_CONN_PER_IP=0
# the audit trail (AUDIT_LOG: a path or - for stdout — the default sink
# in docker is stdout via the image's CMD flag)
#AUDIT_LOG=-
#AUDIT_MAX_MB=10
#AUDIT_DAILY=off
#AUDIT_FILES=3
#AUDIT_FORWARD=none
#AUDIT_FORWARD_FORMAT=rfc5424
#NO_AUDIT_LOG=off

# The simulation knobs: the same twins SIGHUP re-applies (keep-last-good) —
# set them here to reach a container at creation (compose recreates on an
# env-file change) or retune a running one with
# `docker compose kill -s HUP fake-inverter` (PROFILE and LOG_LEVEL
# re-read too — see their notes above).
#
# the hostile-reply probability, 0..1
#CHAOS=0.05
# the PV array size in kWp (peak = 75 % of it)
#MAX_KWP=20
# exception 02 on undefined registers, on|off
#STRICT=on
# freeze the simulated clock, HH:MM
#TIME=13:37
# the simulated clock speed: N times real time
#TIME_SCALE=1
