# The modbus-fake-inverter's env file — GENERATED by
# scripts/generators/examples.py from inverter/lib/options.json (the
# one-knob-one-source rows): every env twin the registry declares is below —
# 35 of them. Edit the registry and re-run the generator, never this file.
# cp env/modbus-fake-inverter.env.example env/modbus-fake-inverter.env and
# edit. A knob's value resolves flag > env > the bundled conf > built-in
# default — an env here overrides the image's conf knob by knob. Every line
# starts commented: the sample value is what the image itself runs (the CMD
# flag or an ENV where one pins it, the built-in default otherwise); a
# secret's line stays empty — pass it as file:<path>, an owner-only 0600
# file (the F12 discipline).

# The demo compose reads the file (env_file:, required: false — no file =
# the image defaults); prod runs no fake service.

# --- system ---

# listen address HOST:PORT
# the image's CMD pins this flag — the env file cannot beat it in docker
# (replace the CMD to move the bind); the twin serves the non-docker
# surfaces
#LISTEN=0.0.0.0:5502

# log verbosity
# a both-layers twin: the SIGHUP re-read applies it too
#LOG_LEVEL=INFO

# --- modbus ---

# device profile JSON (a bare name resolves in shared/profiles/)
# a both-layers twin: the SIGHUP re-read applies it too
#MODBUS_PROFILE=sun2000

# the Modbus auth scheme: suite (the crypt handshake) or none
# the demo stack pins this to the stack's suite key (environment beats
# env_file)
#MODBUS_AUTH=none

# the suite handshake's shared key, min 16 characters (`file:<path>` reads
# an owner-only file)
# the demo stack pins this to the stack's suite key (environment beats
# env_file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#MODBUS_AUTH_KEY=

# --- general ---

# PV array size (peak = 75 % of it)
# the SIGHUP re-read re-applies it to a running container (keep-last-good)
#MAX_KWP=6

# freeze the clock HH:MM (jumps integrate the battery), or auto
# the SIGHUP re-read re-applies it to a running container (keep-last-good)
#TIME=

# the simulated clock speed: N× real time — the machines integrate over it
# the SIGHUP re-read re-applies it to a running container (keep-last-good)
#TIME_SCALE=1

# reject undefined registers with exception 02
# the SIGHUP re-read re-applies it to a running container (keep-last-good)
#STRICT=off

# hostile-reply probability; off = disable
# the SIGHUP re-read re-applies it to a running container (keep-last-good)
#CHAOS=0

# the Modbus clients allowed to connect (the cache's connect-acl, mirrored:
# "any", "none", or a comma-separated IP/CIDR list)
#CONNECT_ACL=any

# simultaneous client limit
#MAX_CLIENTS=64

# disconnect clients silent for this long
#CLIENT_TIMEOUT=300

# simultaneous connections from one peer IP
#MAX_CONN_PER_IP=0

# --- write ---

# accept Modbus writes (FC05/06/15/16) from clients; off = every write
# refused
#ALLOW_WRITE=off

# --- control ---

# control server target: unix socket path
#CTL=

# require a token on control connections: the client authenticates with
# {"cmd": "auth", "token":...}; over the unix socket a trusted peer (root,
# the daemon's own user or --control-trust-uids — SO_PEERCRED) skips the
# token (`file:<path>` = the token from an owner-only file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#CONTROL_TOKEN=

# extra peer uids the unix control socket trusts without the token
# (SO_PEERCRED — a local systemd unit speaks without the secret); root and
# the daemon's own user are always trusted
#CONTROL_TRUST_UIDS=

# leave the unix control socket group-accessible (chmod 0660 instead of the
# plain 0600): a local group may speak to the control without being the
# service user
#CONTROL_SOCKET_GROUP=off

# --- control/ops ---

# a second, read-only control token: sessions authenticating with it may run
# its policy's verbs only (the default policy: show) (no set/clear, no
# reset, no shutdown) — the ops shift against the admin key, both audited
# (`file:<path>` = the token from an owner-only file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#CONTROL_OPS_TOKEN=

# the read-only ops role's RBAC policy: the verbs its sessions may run,
# comma-separated
#CONTROL_OPS_VERBS=show

# --- metrics ---

# the metrics bearer token (Authorization: Bearer) — startup-only (pass it
# by flag/env/config); the value never renders back (`file:<path>` = the
# token from an owner-only file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#METRICS_TOKEN=

# clients allowed to connect to /metrics: "any", "none", comma-separated
# IPs/prefixes, or file:<path> (the ip-prefix acl file)
#METRICS_ACL=any

# --- audit ---

# the audit trail's file: a path, - for stdout, none = no local file (the
# forward carries the trail), empty = the XDG state home
# the image's CMD pins this flag — the env file cannot beat it in docker
# (replace the CMD to move the bind); the twin serves the non-docker
# surfaces
#AUDIT_LOG=-

# also forward every audit line: the local syslog mirror or a remote
# collector (the off-box copy)
#AUDIT_FORWARD=none

# the remote forward's envelope: RFC5424 (the default) or CEF — the local
# syslog forms keep the verbatim send
#AUDIT_FORWARD_FORMAT=rfc5424

# the audit lines' instance word: the writer daemon's identity — the control
# port when unset, the override when spelled
#AUDIT_INSTANCE=

# disable the audit trail entirely
#NO_AUDIT_LOG=off

# --- audit/rotate ---

# rotate the audit trail at this size in MB, keeping N backups; 0 = no size
# rotation
#AUDIT_MAX_MB=10

# also rotate the audit trail at UTC midnight
#AUDIT_DAILY=off

# rotated audit backups to keep
#AUDIT_FILES=3

# --- dump ---

# the state dump file: the live overrides, written on request dump, the
# graceful shutdown and every dump-interval
#DUMP_PATH=

# the key that seals the state dumps (the reload's state file too)
# (`file:<path>` reads an owner-only file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#DUMP_KEY=

# seconds between the automatic state dumps (the live setting overrides)
#DUMP_INTERVAL=0

# the dump loads on start (off: on demand with request restore)
#RESTORE_ON_START=off
