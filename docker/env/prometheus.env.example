# The demo Prometheus's env file — cp env/prometheus.env.example
# env/prometheus.env and edit. Consumed two ways: `docker run --env-file
# env/prometheus.env pv-prometheus` and the compose stack's env_file:
# (required: false — no file = the entrypoint defaults). The names are
# the entrypoint's PROM_* knobs; every line starts commented, the
# defaults live in entrypoint-prometheus.sh.

# The TSDB retention — a prometheus duration (15d, 90d, 1y, ...). The
# entrypoint default keeps 90 days of scrapes on the prometheus-data
# volume.
#PROM_RETENTION=90d

# on = the lifecycle API (POST /-/reload after editing prometheus.yml,
# POST /-/quit to stop the collector). The endpoint sits on the internal
# network only.
#PROM_LIFECYCLE=off

# on = the admin API (snapshots, delete_series) — powerful and
# destructive; keep off unless a runbook needs it.
#PROM_ADMIN_API=off
