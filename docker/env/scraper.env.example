# The modbus-scraper's env file — GENERATED by scripts/gen_env.py from
# scraper/lib/options.json (the one-knob-one-source rows): every env twin
# the registry declares is below — 39 of them. Edit the registry and re-run
# the generator, never this file. cp env/scraper.env.example env/scraper.env
# and edit. A knob's value resolves flag > env > the bundled conf > built-in
# default — an env here overrides the image's conf knob by knob. Every line
# starts commented: the sample value is what the image itself runs (the CMD
# flag or an ENV where one pins it, the built-in default otherwise); a
# secret's line stays empty — pass it as file:<path>, an owner-only 0600
# file (the F12 discipline).

# Both compose stacks read the file (env_file:, required: false — no file =
# the image defaults); the stacks' environment block pins the auth knobs the
# notes below mark.

# --- modbus ---

# the inverter Modbus endpoint
# the image's ENV carries this default (the compose stack's peer service) —
# the env file wins over an ENV
#UPSTREAM=modbus-cache:15502

# Modbus unit ID
#MODBUS_UNIT=1

# added to register addresses
#MODBUS_OFFSET=0

# the auth settings: the Modbus scheme the poll session speaks (modbus auth
# — suite or none) and the bearer token the metrics endpoint requires (auth
# token)
# both compose stacks pin this to the stack's suite key (the scraper proves
# it to the cache — environment beats env_file)
#MODBUS_AUTH=none

# the suite handshake's shared key, min 16 characters (`file:<path>` reads
# an owner-only file)
# both compose stacks pin this to the stack's suite key (the scraper proves
# it to the cache — environment beats env_file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#AUTH_KEY=

# Modbus connect/read timeout
#TIMEOUT=3

# device profile JSON: the registers the metrics read (a bare name resolves
# in profiles/profiles/)
#PROFILE=sun2000

# grid register positive when importing
#GRID_POSITIVE_IMPORT=off

# --- metrics ---

# metrics spec JSON, sectioned: {inputs: {name: {help}}, metrics: {key:
# {profile?, expr?, when?, help, type?}}, scraper:...} — the metrics entries
# are register- (profile) or expression-fed (expr/when) over the declared
# inputs (show inputs), merged in memory over the built-in lib/metrics.json
# scraper_* block
# the image's ENV points it at the volume copy — the env file wins over an
# ENV
#METRICS_SPEC=/config/metrics.json

# the prefix on the profile- and compute-fed metric names
#METRIC_PREFIX=huawei

# clients allowed to connect to /metrics: "any", "none", comma-separated
# IPs/prefixes, or file:<path> (the ip-prefix acl file)
#METRICS_ACL=any

# seconds between polls of the inverter
#INTERVAL=10

# --- caps ---

# maximum PV array kWp
#MAX_KWP=6

# maximum grid kW, either direction
#MAX_GRID_KW=12

# --- system ---

# listen address HOST:PORT
# the image's CMD pins this flag — the env file cannot beat it in docker
# (replace the CMD to move the bind); the twin serves the non-docker
# surfaces
#LISTEN=0.0.0.0:9350

# --- general ---

# log timestamps in the system time zone instead of UTC
#LOCAL_TIME=off

# log every HTTP request at INFO
#LOG_ACCESS=off

# log verbosity
#LOG_LEVEL=INFO

# seconds between the automatic state dumps (the live setting overrides)
#DUMP_INTERVAL=0

# --- metrics/limits ---

# simultaneous HTTP clients on /metrics; extras get an immediate 503
#MAX_CLIENTS=64

# kick idle keep-alive HTTP clients after this long
#CLIENT_TIMEOUT=300

# simultaneous HTTP connections from one peer IP
#MAX_CONN_PER_IP=0

# --- control ---

# JSON-lines control server target: unix socket path
#CTL=

# require a token on control connections: the client authenticates with
# {"cmd": "auth", "token":...}; over the unix socket a trusted peer (root,
# the daemon's own user or --control-trust-uids — SO_PEERCRED) skips the
# token (`file:<path>` = the token from an owner-only file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#CONTROL_TOKEN=

# extra peer uids the unix control socket trusts without the token
# (SO_PEERCRED — a local systemd unit speaks without the secret); root and
# the daemon's own user are always trusted
#CONTROL_TRUST_UIDS=

# leave the unix control socket group-accessible (chmod 0660 instead of the
# plain 0600)
#CONTROL_SOCKET_GROUP=off

# --- control/ops ---

# a second, read-only control token: sessions authenticating with it may run
# its policy's verbs only (the default policy: show) (no set/clear, no poll
# now, no request reload, no restart, no shutdown) — the ops shift against
# the admin key, both audited (`file:<path>` = the token from an owner-only
# file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#CONTROL_OPS_TOKEN=

# the read-only ops role's RBAC policy: the verbs its sessions may run,
# comma-separated
#CONTROL_OPS_VERBS=show

# --- metrics/auth ---

# require Authorization: Bearer <token> on all requests — startup-only (pass
# it by flag/env/config); the value never renders back (`file:<path>` = the
# token from an owner-only file)
# the compose stacks pin AUTH_TOKEN to the generated /config/metrics.token
# (environment beats env_file) — this line is the plain-docker spelling
# a secret — pass it as file:<path>, an owner-only 0600 file
#AUTH_TOKEN=file:/config/metrics.token

# --- audit ---

# SCR audit trail: a file path or - for stdout (the docker/journald way);
# `none` = no local file (the forward carries the trail); default: the XDG
# state home (~/.local/state/modbus-scraper/audit.log)
#AUDIT_LOG=

# also forward every audit line: the local syslog mirror or a remote
# collector (the off-box copy)
#AUDIT_FORWARD=none

# the remote forward's envelope: RFC5424 (the default) or CEF — the local
# syslog forms keep the verbatim send
#AUDIT_FORWARD_FORMAT=rfc5424

# disable the SCR audit trail
#NO_AUDIT_LOG=off

# --- audit/rotate ---

# rotate the audit log at this size in MB, keeping N backups; 0 = no size
# rotation
#AUDIT_MAX_MB=10

# also rotate the audit log at UTC midnight
#AUDIT_DAILY=off

# rotated audit backups to keep
#AUDIT_FILES=3

# --- dump ---

# the state dump file: the live overrides, written on request dump, the
# graceful shutdown and every dump-interval
#DUMP_PATH=

# the key that seals the state dumps (the reload's state file too)
# (`file:<path>` reads an owner-only file)
# a secret — pass it as file:<path>, an owner-only 0600 file
#DUMP_KEY=

# the dump loads on start (off: on demand with request restore)
#RESTORE_ON_START=off
