        "version": "1"
      },
      "constraints": [
        {
          "type": "server-version",
          "version": ">=4.0.0"
        }
      ],
      "data": {
        "title": "pv-suite audit (syslog UDP)",
        "configuration": {
          "bind_address": "0.0.0.0",
          "port": 1514,
          "recv_buffer_size": 1048576,
          "number_worker_threads": 2,
          "force_rdns": false,
          "allow_override_date": true,
          "expand_structured_data": false,
          "store_full_message": true
        },
        "static_fields": {
          "source": "pv-suite"
        },
        "type": "org.graylog2.inputs.syslog.udp.SyslogUDPInput",
        "global": true
      }
    },
    {
      "id": "3245b1ba-b17b-5721-af96-672ac472a20a",
      "type": {
        "name": "pipeline_rule",
        "version": "1"
      },
      "constraints": [
        {
          "type": "server-version",
          "version": ">=4.0.0"
        }
      ],
      "data": {
        "title": "pv-suite audit kv",
        "source": "rule \"pv-suite audit kv\"\nwhen\n    has_field(\"message\") AND contains(to_string($message.message), \" AUDIT \")\nthen\n    let msg = to_string($message.message);\n    let kv = key_value(msg, quote: \"'\", ignore_empty_values: true);\n    set_fields(kv, prefix: \"audit_\");\nend"
      }
    },
    {
      "id": "31bc27da-2e5d-568c-a22f-bcb8bfc47738",
      "type": {
        "name": "pipeline_rule",
        "version": "1"
      },
      "constraints": [
        {
          "type": "server-version",
          "version": ">=4.0.0"
        }
      ],
      "data": {
        "title": "pv-suite audit cmd",
        "source": "rule \"pv-suite audit cmd\"\nwhen\n    has_field(\"message\") AND contains(to_string($message.message), \" cmd=\")\nthen\n    let msg = to_string($message.message);\n    let m = regex(\" cmd='(?<cmd>(?:\\\\\\\\.|[^'])*)'\", msg);\n    let unescaped = replace(to_string(m[\"cmd\"]), \"\\\\\\\\(.)\", \"$1\");\n    set_field(\"audit_cmd\", unescaped);\nend"
      }
    },
    {
      "id": "2f7da5d5-807a-542a-8ede-b25dd20deb6d",
      "type": {
        "name": "pipeline_rule",
        "version": "1"
      },
      "constraints": [
        {
          "type": "server-version",
          "version": ">=4.0.0"
        }
      ],
      "data": {
        "title": "pv-suite audit gim",
        "source": "rule \"pv-suite audit gim\"\nwhen\n    has_field(\"audit_type\")\nthen\n    set_field(\"event_source_product\", \"pv-suite\");\n    set_field(\"event_action\", to_string($message.audit_type));\n    set_field(\"event_uid\", to_string($message.audit_hash));\n    set_field(\"application_name\", to_string($message.audit_application));\n    set_field(\"event_outcome\", \"success\");\n    set_field(\"event_severity\", \"informational\");\n    set_field(\"event_severity_level\", 1);\n    if has_field(\"audit_result\") AND to_string($message.audit_result) == \"err\" then\n        set_field(\"event_outcome\", \"failure\");\n        set_field(\"event_severity\", \"medium\");\n        set_field(\"event_severity_level\", 3);\n    end\n    if to_string($message.audit_type) == \"auth-fail\" then\n        set_field(\"event_severity\", \"high\");\n        set_field(\"event_severity_level\", 4);\n    end\n    if has_field(\"audit_reason\") then\n        set_field(\"event_error_code\", to_string($message.audit_reason));\n    end\n    if has_field(\"audit_uptime\") then\n        set_field(\"event_duration\", to_long($message.audit_uptime));\n    end\n    if has_field(\"audit_cmd\") then\n        set_field(\"user_command\", to_string($message.audit_cmd));\n    end\n    if has_field(\"audit_role\") then\n        set_field(\"user_name\", to_string($message.audit_role));\n    end\n    if has_field(\"audit_user\") then\n        set_field(\"user_name\", to_string($message.audit_user));\n    end\n    if has_field(\"audit_peer\") AND contains(to_string($message.audit_peer), \":\") then\n        let peer_parts = split(\":\", to_string($message.audit_peer));\n        set_field(\"source_ip\", to_string(peer_parts[0]));\n        set_field(\"source_port\", to_long(peer_parts[1]));\n    end\n    if has_field(\"audit_target\") AND contains(to_string($message.audit_target), \":\") then\n        let target_parts = split(\":\", to_string($message.audit_target));\n        if to_string(target_parts[0]) != \"unix\" then\n            set_field(\"destination_ip\", to_string(target_parts[0]));\n            set_field(\"destination_port\", to_long(target_parts[1]));\n        end\n    end\nend"
      }
    },
