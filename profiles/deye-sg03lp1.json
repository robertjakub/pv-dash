    {"name": "grid-power", "register": 169, "type": "i16", "scale": 1, "desc": "grid power (W, + = export)"},
    {"name": "device-temperature", "register": 90, "type": "i16", "scale": 10, "desc": "DC temperature (C x10)"},
    {"name": "yield-day", "register": 108, "type": "u16", "scale": 10, "desc": "daily production (kWh x10)"},
    {"name": "yield-total", "register": 96, "type": "u32", "scale": 10, "desc": "total production (kWh x10)"},
    {"name": "string-1-voltage", "register": 109, "type": "u16", "scale": 10, "desc": "PV1 voltage (V x10)"},
    {"name": "string-1-current", "register": 110, "type": "u16", "scale": 10, "desc": "PV1 current (A x10)"},
    {"name": "string-2-voltage", "register": 111, "type": "u16", "scale": 10, "desc": "PV2 voltage (V x10)"},
    {"name": "string-2-current", "register": 112, "type": "u16", "scale": 10, "desc": "PV2 current (A x10)"},
