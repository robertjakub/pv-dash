{
  "description": "Deye SUN three-phase hybrid (SG04LP3 family) with battery",
  "mappings": [
    {"register": "device-status", "values": {"1": "self-checking", "2": "normal", "3": "fault"}}
  ],
  "registers": [
    {"name": "device-status", "register": 500, "type": "u16", "scale": 1, "desc": "running status code: 1 = self-checking, 2 = normal, 3 = fault"},
    {"name": "pv-power", "register": 672, "type": "u16", "scale": 1, "desc": "PV1 power (W)"},
    {"name": "grid-power", "register": 625, "type": "i16", "scale": 1, "desc": "grid power (W, + = export)"},
    {"name": "device-temperature", "register": 540, "type": "i16", "scale": 10, "desc": "DC temperature (C x10)"},
    {"name": "yield-day", "register": 529, "type": "u16", "scale": 10, "desc": "daily production (kWh x10)"},
    {"name": "yield-total", "register": 534, "type": "u32", "scale": 10, "desc": "total production (kWh x10)"},
    {"name": "string-1-voltage", "register": 676, "type": "u16", "scale": 10, "desc": "PV1 voltage (V x10)"},
    {"name": "string-1-current", "register": 677, "type": "u16", "scale": 10, "desc": "PV1 current (A x10)"},
    {"name": "string-2-voltage", "register": 678, "type": "u16", "scale": 10, "desc": "PV2 voltage (V x10)"},
    {"name": "string-2-current", "register": 679, "type": "u16", "scale": 10, "desc": "PV2 current (A x10)"},
    {"name": "meter-voltage-a", "register": 598, "type": "u16", "scale": 10, "desc": "grid voltage L1 (V x10)"},
    {"name": "meter-voltage-b", "register": 599, "type": "u16", "scale": 10, "desc": "grid voltage L2 (V x10)"},
    {"name": "meter-voltage-c", "register": 600, "type": "u16", "scale": 10, "desc": "grid voltage L3 (V x10)"},
    {"name": "battery-power", "register": 590, "type": "i16", "scale": 1, "desc": "battery power (W, + = charging)"},
    {"name": "battery-soc", "register": 588, "type": "u16", "scale": 1, "desc": "battery SOC (%)"},
    {"name": "battery-charge-today", "register": 514, "type": "u16", "scale": 10, "desc": "battery charged today (kWh x10)"},
    {"name": "battery-discharge-today", "register": 515, "type": "u16", "scale": 10, "desc": "battery discharged today (kWh x10)"},
    {"name": "battery-charge-total", "register": 516, "type": "u32", "scale": 10, "desc": "total battery charge (kWh x10)"},
    {"name": "battery-discharge-total", "register": 518, "type": "u32", "scale": 10, "desc": "total battery discharge (kWh x10)"}
  ]
}
