{
  "description": "Deye SUN-12K-SG05LP3-EU three-phase hybrid with battery",
  "acl": {
    "write": {
      "desc": "Time-of-Use schedule slots (148-177) and operational mode registers (127-128)",
      "rules": [
        {"type": "allow", "range": "127:2", "desc": "operational mode registers"},
        {"type": "allow", "range": "148:30", "desc": "Time-of-Use schedule slots"}
      ]
    }
  },
  "mappings": [
    {"register": "device-status", "values": {"0": "standby", "1": "self-checking", "2": "normal", "3": "alarm", "4": "fault"}}
  ],
  "registers": [
    {"name": "grid-start-soc", "register": 127, "type": "u16", "scale": 1, "desc": "Grid Start Battery % (R/W)"},
    {"name": "grid-charge-current", "register": 128, "type": "u16", "scale": 1, "desc": "Grid Charge Current A (R/W)"},
    {"name": "tou-time-1", "register": 148, "type": "u16", "scale": 1, "desc": "TOU Time 1 (e.g. 00:00 -> 0) (R/W)"},
    {"name": "tou-time-2", "register": 149, "type": "u16", "scale": 1, "desc": "TOU Time 2 (e.g. 06:00 -> 600) (R/W)"},
    {"name": "tou-time-3", "register": 150, "type": "u16", "scale": 1, "desc": "TOU Time 3 (e.g. 13:00 -> 1300) (R/W)"},
    {"name": "tou-time-4", "register": 151, "type": "u16", "scale": 1, "desc": "TOU Time 4 (e.g. 15:00 -> 1500) (R/W)"},
    {"name": "tou-time-5", "register": 152, "type": "u16", "scale": 1, "desc": "TOU Time 5 (e.g. 22:00 -> 2200) (R/W)"},
    {"name": "tou-time-6", "register": 153, "type": "u16", "scale": 1, "desc": "TOU Time 6 (e.g. 22:00 -> 2200) (R/W)"},
    {"name": "tou-soc-1", "register": 166, "type": "u16", "scale": 1, "desc": "TOU Target SOC 1 (%) (R/W)"},
    {"name": "tou-soc-2", "register": 167, "type": "u16", "scale": 1, "desc": "TOU Target SOC 2 (%) (R/W)"},
    {"name": "tou-soc-3", "register": 168, "type": "u16", "scale": 1, "desc": "TOU Target SOC 3 (%) (R/W)"},
    {"name": "tou-soc-4", "register": 169, "type": "u16", "scale": 1, "desc": "TOU Target SOC 4 (%) (R/W)"},
    {"name": "tou-soc-5", "register": 170, "type": "u16", "scale": 1, "desc": "TOU Target SOC 5 (%) (R/W)"},
    {"name": "tou-soc-6", "register": 171, "type": "u16", "scale": 1, "desc": "TOU Target SOC 6 (%) (R/W)"},
    {"name": "tou-charge-1", "register": 172, "type": "u16", "scale": 1, "desc": "TOU Grid Charge Enable 1 (0/1) (R/W)"},
    {"name": "tou-charge-2", "register": 173, "type": "u16", "scale": 1, "desc": "TOU Grid Charge Enable 2 (0/1) (R/W)"},
    {"name": "tou-charge-3", "register": 174, "type": "u16", "scale": 1, "desc": "TOU Grid Charge Enable 3 (0/1) (R/W)"},
    {"name": "tou-charge-4", "register": 175, "type": "u16", "scale": 1, "desc": "TOU Grid Charge Enable 4 (0/1) (R/W)"},
    {"name": "tou-charge-5", "register": 176, "type": "u16", "scale": 1, "desc": "TOU Grid Charge Enable 5 (0/1) (R/W)"},
    {"name": "tou-charge-6", "register": 177, "type": "u16", "scale": 1, "desc": "TOU Grid Charge Enable 6 (0/1) (R/W)"},
    {"name": "device-status", "register": 500, "type": "u16", "scale": 1, "desc": "Running status code (2 = normal)"},
    {"name": "battery-charge-today", "register": 514, "type": "u16", "scale": 10, "desc": "Charged today (0.1 kWh)"},
    {"name": "battery-discharge-today", "register": 515, "type": "u16", "scale": 10, "desc": "Discharged today (0.1 kWh)"},
    {"name": "battery-charge-total", "register": 516, "type": "u32", "scale": 10, "desc": "Total charge (0.1 kWh)"},
    {"name": "battery-discharge-total", "register": 518, "type": "u32", "scale": 10, "desc": "Total discharge (0.1 kWh)"},
    {"name": "grid-buy-today", "register": 520, "type": "u16", "scale": 10, "desc": "Day_GridBuy_Power (0.1 kWh)"},
    {"name": "grid-sell-today", "register": 521, "type": "u16", "scale": 10, "desc": "Day_GridSell_Power (0.1 kWh)"},
    {"name": "grid-buy-total", "register": 522, "type": "u32", "scale": 10, "desc": "Total_GridBuy_Power (0.1 kWh)"},
    {"name": "grid-sell-total", "register": 524, "type": "u32", "scale": 10, "desc": "Total_GridSell_Power (0.1 kWh)"},
    {"name": "load-today", "register": 526, "type": "u16", "scale": 10, "desc": "Day_Load_Power (0.1 kWh) - House consumption"},
    {"name": "load-total", "register": 527, "type": "u32", "scale": 10, "desc": "Total_Load_Power (0.1 kWh)"},
    {"name": "yield-day", "register": 529, "type": "u16", "scale": 10, "desc": "Daily PV yield (0.1 kWh)"},
    {"name": "pv1-day-energy", "register": 530, "type": "i16", "scale": 10, "desc": "Day PV1 Energy (0.1 kWh)"},
    {"name": "pv2-day-energy", "register": 531, "type": "i16", "scale": 10, "desc": "Day PV2 Energy (0.1 kWh)"},
    {"name": "pv3-day-energy", "register": 532, "type": "i16", "scale": 10, "desc": "Day PV3 Energy (0.1 kWh)"},
    {"name": "pv4-day-energy", "register": 533, "type": "i16", "scale": 10, "desc": "Day PV4 Energy (0.1 kWh)"},
    {"name": "yield-total", "register": 534, "type": "u32", "scale": 10, "desc": "Total PV yield (0.1 kWh)"},
    {"name": "gen-day-energy", "register": 536, "type": "i16", "scale": 10, "desc": "Generator day energy (0.1 kWh)"},
    {"name": "gen-total-energy-low", "register": 537, "type": "i16", "scale": 10, "desc": "Generator total energy low"},
    {"name": "gen-total-energy-high", "register": 538, "type": "i16", "scale": 10, "desc": "Generator total energy high"},
    {"name": "gen-day-hours", "register": 539, "type": "i16", "scale": 10, "desc": "Generator day hours (0.1 h)"},
    {"name": "device-temperature", "register": 540, "type": "i16", "scale": 10, "desc": "DC temperature (0.1 C)"},
    {"name": "radiator-temperature", "register": 541, "type": "i16", "scale": 10, "desc": "Heat sink temperature (0.1 C, offset 1000)"},
    {"name": "battery-temp-sensor", "register": 585, "type": "u16", "scale": 1, "desc": "Battery temp sensor"},
    {"name": "battery-temperature", "register": 586, "type": "u16", "scale": 10, "desc": "Battery 1 temperature with offset 1000 (0.1 C, 1250 = 25.0C)"},
    {"name": "battery-voltage", "register": 587, "type": "u16", "scale": 100, "desc": "Battery 1 voltage (0.01 V, 5120 = 51.2V)"},
    {"name": "battery-soc", "register": 588, "type": "u16", "scale": 1, "desc": "Battery 1 SOC (%)"},
    {"name": "battery-2-soc", "register": 589, "type": "u16", "scale": 1, "desc": "Battery 2 SOC (%)"},
    {"name": "battery-power", "register": 590, "type": "i16", "scale": -1, "desc": "Battery output power (W, + = discharge, - = charge)"},
    {"name": "battery-current", "register": 591, "type": "i16", "scale": 100, "desc": "Battery 1 current (0.01 A)"},
    {"name": "meter-voltage-a", "register": 598, "type": "u16", "scale": 10, "desc": "Grid voltage L1 (0.1 V)"},
    {"name": "meter-voltage-b", "register": 599, "type": "u16", "scale": 10, "desc": "Grid voltage L2 (0.1 V)"},
    {"name": "meter-voltage-c", "register": 600, "type": "u16", "scale": 10, "desc": "Grid voltage L3 (0.1 V)"},
    {"name": "grid-current-l1", "register": 613, "type": "i16", "scale": 100, "desc": "Grid external CT current L1 (0.01A)"},
    {"name": "grid-current-l2", "register": 614, "type": "i16", "scale": 100, "desc": "Grid external CT current L2 (0.01A)"},
    {"name": "grid-current-l3", "register": 615, "type": "i16", "scale": 100, "desc": "Grid external CT current L3 (0.01A)"},
    {"name": "grid-power", "register": 625, "type": "i16", "scale": 1, "desc": "Grid active power (W, + = import, - = export)"},
    {"name": "reserved-626", "register": 626, "type": "u16", "scale": 1, "desc": "Reserved 626"},
    {"name": "inverter-voltage-a", "register": 627, "type": "u16", "scale": 10, "desc": "Inverter output voltage L1 (0.1 V)"},
    {"name": "inverter-voltage-b", "register": 628, "type": "u16", "scale": 10, "desc": "Inverter output voltage L2 (0.1 V)"},
    {"name": "inverter-voltage-c", "register": 629, "type": "u16", "scale": 10, "desc": "Inverter output voltage L3 (0.1 V)"},
    {"name": "inverter-current-l1", "register": 630, "type": "i16", "scale": 100, "desc": "Inverter output current L1 (0.01A)"},
    {"name": "inverter-current-l2", "register": 631, "type": "i16", "scale": 100, "desc": "Inverter output current L2 (0.01A)"},
    {"name": "inverter-current-l3", "register": 632, "type": "i16", "scale": 100, "desc": "Inverter output current L3 (0.01A)"},
    {"name": "inverter-output-power", "register": 636, "type": "i16", "scale": 1, "desc": "Inverter total active power (W)"},
    {"name": "inverter-output-apparent", "register": 637, "type": "i16", "scale": 1, "desc": "Inverter apparent power (VA)"},
    {"name": "grid-frequency", "register": 638, "type": "u16", "scale": 100, "desc": "Grid frequency (0.01 Hz, 5000 = 50.00Hz)"},
    {"name": "reserved-639", "register": 639, "type": "i16", "scale": 1, "desc": "Reserved 639"},
    {"name": "ups-power-l1", "register": 640, "type": "i16", "scale": 1, "desc": "UPS load phase power A (1W)"},
    {"name": "ups-power-l2", "register": 641, "type": "i16", "scale": 1, "desc": "UPS load phase power B (1W)"},
    {"name": "ups-power-l3", "register": 642, "type": "i16", "scale": 1, "desc": "UPS load phase power C (1W)"},
    {"name": "ups-total-power", "register": 643, "type": "i16", "scale": 1, "desc": "UPS load total power (1W)"},
    {"name": "load-voltage-a", "register": 644, "type": "u16", "scale": 10, "desc": "Load voltage A (0.1 V)"},
    {"name": "load-voltage-b", "register": 645, "type": "u16", "scale": 10, "desc": "Load voltage B (0.1 V)"},
    {"name": "load-voltage-c", "register": 646, "type": "u16", "scale": 10, "desc": "Load voltage C (0.1 V)"},
    {"name": "load-current-l1", "register": 647, "type": "i16", "scale": 1, "desc": "Load phase current A (0.01A)"},
    {"name": "load-current-l2", "register": 648, "type": "i16", "scale": 1, "desc": "Load phase current B (0.01A)"},
    {"name": "load-current-l3", "register": 649, "type": "i16", "scale": 1, "desc": "Load phase current C (0.01A)"},
    {"name": "load-power-l1", "register": 650, "type": "i16", "scale": 1, "desc": "Load phase power A (1W)"},
    {"name": "load-power-l2", "register": 651, "type": "i16", "scale": 1, "desc": "Load phase power B (1W)"},
    {"name": "load-power-l3", "register": 652, "type": "i16", "scale": 1, "desc": "Load phase power C (1W)"},
    {"name": "home-power", "register": 653, "type": "i16", "scale": 1, "desc": "Load total power (W)"},
    {"name": "pv-power", "register": 672, "type": "u16", "scale": 1, "desc": "PV1 power (W)"},
    {"name": "pv2-power", "register": 673, "type": "u16", "scale": 1, "desc": "PV2 power (W)"},
    {"name": "string-1-voltage", "register": 676, "type": "u16", "scale": 10, "desc": "PV1 voltage (0.1 V)"},
    {"name": "string-1-current", "register": 677, "type": "u16", "scale": 10, "desc": "PV1 current (0.1 A)"},
    {"name": "string-2-voltage", "register": 678, "type": "u16", "scale": 10, "desc": "PV2 voltage (0.1 V)"},
    {"name": "string-2-current", "register": 679, "type": "u16", "scale": 10, "desc": "PV2 current (0.1 A)"}
  ]
}
