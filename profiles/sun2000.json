{
  "description": "SUN2000 with optional LUNA2000 battery and meter",
  "mappings": [
    {"register": "device-status", "values": {"512": "on-grid", "40960": "standby"}},
    {"register": "meter-status", "values": {"1": "normal"}},
    {"register": "meter-mode", "values": {"1": "CT", "2": "direct connection"}}
  ],
  "registers": [
    {"name": "pv-power", "register": 32064, "type": "i32", "scale": 1, "desc": "PV power, all strings (W)"},
    {"name": "pv-limit", "register": 32080, "type": "i32", "scale": 1, "desc": "PV power limit (W)"},
    {"name": "pv-dc-total", "register": 32078, "type": "i32", "scale": 1, "desc": "PV DC total power (W)"},
    {"name": "device-status", "register": 32089, "type": "u16", "scale": 1, "desc": "status: 512 = on-grid, 40960 = standby"},
    {"name": "device-temperature", "register": 32087, "type": "i16", "scale": 10, "desc": "device temperature (C x10)"},
    {"name": "device-reactive-power", "register": 32082, "type": "i32", "scale": 1, "desc": "device reactive power (var)"},
    {"name": "device-power-factor", "register": 32084, "type": "u16", "scale": 1000, "desc": "device power factor (x1000)"},
    {"name": "device-insulation", "register": 32086, "type": "u16", "scale": 1, "desc": "insulation resistance"},
    {"name": "grid-frequency", "register": 32085, "type": "u16", "scale": 100, "desc": "grid frequency (Hz x100)"},
    {"name": "yield-total", "register": 32106, "type": "u32", "scale": 100, "desc": "total yield (kWh x100)"},
    {"name": "yield-day", "register": 32114, "type": "u32", "scale": 100, "desc": "daily yield (kWh x100)"},
    {"name": "grid-power", "register": 37113, "type": "i32", "scale": 1, "desc": "grid power (W, + = export)"},
    {"name": "string-1-voltage", "register": 32016, "type": "u16", "scale": 10, "desc": "PV string 1 voltage (V x10)"},
    {"name": "string-1-current", "register": 32017, "type": "u16", "scale": 100, "desc": "PV string 1 current (A x100)"},
    {"name": "string-2-voltage", "register": 32018, "type": "u16", "scale": 10, "desc": "PV string 2 voltage (V x10)"},
    {"name": "string-2-current", "register": 32019, "type": "u16", "scale": 100, "desc": "PV string 2 current (A x100)"},
    {"name": "output-power-a", "register": 32066, "type": "u16", "scale": 1, "desc": "phase A output power (W)"},
    {"name": "output-voltage-a", "register": 32069, "type": "u16", "scale": 10, "desc": "phase A output voltage (V x10)"},
    {"name": "output-current-a", "register": 32072, "type": "i32", "scale": 1000, "desc": "phase A output current (A x1000)"},
    {"name": "output-power-b", "register": 32067, "type": "u16", "scale": 1, "desc": "phase B output power (W)"},
    {"name": "output-voltage-b", "register": 32070, "type": "u16", "scale": 10, "desc": "phase B output voltage (V x10)"},
    {"name": "output-current-b", "register": 32074, "type": "i32", "scale": 1000, "desc": "phase B output current (A x1000)"},
    {"name": "output-power-c", "register": 32068, "type": "u16", "scale": 1, "desc": "phase C output power (W)"},
    {"name": "output-voltage-c", "register": 32071, "type": "u16", "scale": 10, "desc": "phase C output voltage (V x10)"},
    {"name": "output-current-c", "register": 32076, "type": "i32", "scale": 1000, "desc": "phase C output current (A x1000)"},
    {"name": "meter-status", "register": 37100, "type": "u16", "scale": 1, "desc": "meter status"},
    {"name": "meter-voltage-a", "register": 37101, "type": "i32", "scale": 10, "desc": "meter phase A voltage (V x10)"},
    {"name": "meter-current-a", "register": 37107, "type": "i32", "scale": 100, "desc": "meter phase A current (A x100)"},
    {"name": "meter-power-a", "register": 37132, "type": "i32", "scale": 1, "desc": "meter phase A power (W)"},
    {"name": "meter-voltage-b", "register": 37103, "type": "i32", "scale": 10, "desc": "meter phase B voltage (V x10)"},
    {"name": "meter-current-b", "register": 37109, "type": "i32", "scale": 100, "desc": "meter phase B current (A x100)"},
    {"name": "meter-power-b", "register": 37134, "type": "i32", "scale": 1, "desc": "meter phase B power (W)"},
    {"name": "meter-voltage-c", "register": 37105, "type": "i32", "scale": 10, "desc": "meter phase C voltage (V x10)"},
    {"name": "meter-current-c", "register": 37111, "type": "i32", "scale": 100, "desc": "meter phase C current (A x100)"},
    {"name": "meter-power-c", "register": 37136, "type": "i32", "scale": 1, "desc": "meter phase C power (W)"},
    {"name": "meter-reactive-power", "register": 37115, "type": "i32", "scale": 1, "desc": "meter reactive power (var)"},
    {"name": "meter-power-factor", "register": 37117, "type": "u16", "scale": 1000, "desc": "meter power factor (x1000)"},
    {"name": "meter-frequency", "register": 37118, "type": "u16", "scale": 100, "desc": "meter frequency (Hz x100)"},
    {"name": "meter-export", "register": 37119, "type": "u32", "scale": 100, "desc": "meter total export (kWh x100)"},
    {"name": "meter-import", "register": 37121, "type": "u32", "scale": 100, "desc": "meter total import (kWh x100)"},
    {"name": "meter-mode", "register": 37125, "type": "u16", "scale": 1, "desc": "meter mode"},
    {"name": "battery-power", "register": 37001, "type": "i32", "scale": 1, "desc": "battery power (W, + = charging)"},
    {"name": "battery-efficiency", "register": 37003, "type": "u16", "scale": 1, "desc": "battery efficiency"},
    {"name": "battery-soc", "register": 37004, "type": "u16", "scale": 10, "desc": "battery SOC (% x10)"},
    {"name": "battery-soc-reserve", "register": 37760, "type": "u16", "scale": 10, "desc": "battery SOC, second register (% x10)"},
    {"name": "battery-charge-total", "register": 37780, "type": "u32", "scale": 100, "desc": "total battery charge (kWh x100)"},
    {"name": "battery-discharge-total", "register": 37782, "type": "u32", "scale": 100, "desc": "total battery discharge (kWh x100)"},
    {"name": "battery-charge-today", "register": 37784, "type": "u32", "scale": 100, "desc": "battery charged today (kWh x100)"},
    {"name": "battery-discharge-today", "register": 37786, "type": "u32", "scale": 100, "desc": "battery discharged today (kWh x100)"}
  ]
}
